{
  "name": "labmonitor-agent",
  "version": "1.0.0",
  "description": "LabMonitor Agent - Monitoring & Remote Control untuk PC Siswa",
  "main": "src/agent.js",
  "scripts": {
    "start": "node src/agent.js",
    "dev": "nodemon src/agent.js",
    "install-service": "node src/service-installer.js install",
    "uninstall-service": "node src/service-installer.js uninstall"
  },
  "keywords": ["labmonitor", "agent", "monitoring", "education"],
  "author": "LabMonitor Team",
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.7.2",
    "systeminformation": "^5.21.20",
    "active-win": "^8.0.1",
    "dotenv": "^16.3.1",
    "node-windows": "^1.0.0-beta.8",
    "winston": "^3.11.0",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "pkg": {
    "assets": [
      "config/**/*",
      "src/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
