# ========================================
# LabMonitor Frontend Environment Variables
# ========================================

# Backend API URL
VITE_API_URL=http://localhost:3001

# Socket.io URL
VITE_SOCKET_URL=http://localhost:3001

# ========================================
# NETWORK CONFIGURATION
# ========================================

# Server IP Address (untuk ditampilkan di topologi jaringan)
VITE_SERVER_IP=192.168.100.166

# Network Subnet
VITE_SUBNET=192.168.100.0/24

# ========================================
# WEBSITE CLASSIFICATION
# ========================================

# Enable advanced website classification
# Categories: educational, social-media, entertainment, search-engine, 
#             shopping, news, productivity, email, gaming, finance, other
VITE_ENABLE_ADVANCED_CLASSIFICATION=true

# ========================================
# ALERT THRESHOLDS
# ========================================

# CPU usage threshold for warning (%)
VITE_CPU_WARNING_THRESHOLD=80

# CPU usage threshold for critical (%)
VITE_CPU_CRITICAL_THRESHOLD=95

# RAM usage threshold for warning (%)
VITE_RAM_WARNING_THRESHOLD=80

# RAM usage threshold for critical (%)
VITE_RAM_CRITICAL_THRESHOLD=95

# ========================================
# MONITORING INTERVALS
# ========================================

# System monitoring interval (milliseconds)
VITE_SYSTEM_MONITOR_INTERVAL=5000

# Browser monitoring interval (milliseconds)
VITE_BROWSER_MONITOR_INTERVAL=10000

# Screenshot auto-capture interval (milliseconds)
VITE_SCREENSHOT_INTERVAL=3000

# ========================================
# UI CONFIGURATION
# ========================================

# Enable dark mode by default
VITE_DARK_MODE=false

# Enable real-time updates
VITE_ENABLE_REALTIME=true

# Maximum number of activities to display
VITE_MAX_ACTIVITIES_DISPLAY=100

# Maximum number of screenshots to keep
VITE_MAX_SCREENSHOTS=50
